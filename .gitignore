# Local credentials
.env
.env.*
!.env.sample

# Local tools, generated data, measurements and reports
/tmp/
/.playwright-cli/
/.ruff_cache/
/evaluator/data/datasets/
# Standard s1mb run output; keep only the empty-directory placeholder.
/evaluator/data/results/*
!/evaluator/data/results/.gitkeep
/evaluator/audits/

# Published results, synchronization snapshots/locks, and recorded dataset revisions.
/evaluator/data/hub-results
/evaluator/data/.hub-results*
/evaluator/data/result-datasets/

# Conventional explicit --output destinations (not source fixtures).
/output/
/evaluator/output/

# Legacy viewer cache (no longer read)
/viewer/.cache/

# Downloaded remote leaderboard snapshots and synchronization artifacts
/cache/

/viewer/display/

/viewer/scripts/__pycache__/

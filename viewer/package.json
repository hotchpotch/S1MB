{
  "name": "s1mb-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/start.ts --dev",
    "build": "npm run build-storybook && next build",
    "start": "tsx scripts/start.ts",
    "build-storybook": "storybook build --output-dir public/storybook --disable-telemetry",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "apache-arrow": "^21.2.0",
    "class-variance-authority": "^0.7.1",

# TypeSafe API credentials for the evaluator.
# From evaluator/: uv run --env-file ../.env s1mb run ...
TYPESAFE_API_KEY=

# Read access to the private evaluation dataset on Hugging Face.
HF_TOKEN=

# Viewer: opt into results from a Hugging Face Dataset repository.
# The results Dataset is public and can be read without a token. Preparing private
# evaluation inputs still requires HF_TOKEN. Clear this value for local results.
# CLI --results-repo and --results-revision override these runtime settings.
S1MB_HF_RESULTS_REPO=hotchpotch/s1mb-result
# A branch, tag or commit; every download is pinned to its resolved SHA-1.
S1MB_HF_RESULTS_REVISION=main
# Seconds between checks, on the first request after expiry. Minimum: 3600.
S1MB_HF_RESULTS_CACHE_SECONDS=3600
# Defaults to the OS temporary directory / s1mb-viewer-results.
# Mount a writable volume here to preserve downloads and the check time on restart.
S1MB_HF_RESULTS_CACHE_DIR=
# Optional absolute path to the prepared evaluation data (read-only is supported).
# Defaults to viewer/data. Include recorded revisions under result-datasets/.
S1MB_DATA_DIR=

# HF Space deployment (GitHub Actions repository variables; leave unset to disable).
# The existing Space must be private and use the Docker SDK.
S1MB_SPACE_REPO=hotchpotch/S1MB-leaderboard
# Format: ghcr.io/OWNER/IMAGE, lowercase, without a tag or digest.
# This code-only image must be anonymously pullable by HF Spaces.
S1MB_SPACE_IMAGE=ghcr.io/hotchpotch/s1mb-leaderboard
# GitHub Actions secret: token with write access to the private Space.
# Do not pass this token to the running viewer. Configure a separate read-only
# HF_TOKEN in Space Secrets and S1MB_HF_RESULTS_REPO in Space Variables.
S1MB_SPACE_DEPLOY_TOKEN=

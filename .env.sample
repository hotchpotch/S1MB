# Evaluator credentials (never included in the viewer image).
TYPESAFE_API_KEY=
HF_TOKEN=

# Viewer runtime: prepared local display JSON; default viewer/display/viewer-summary.json.
S1MB_DISPLAY_FILE=

# GitHub Actions repository variables: Docker Space and public image with display JSON.
S1MB_SPACE_REPO=hotchpotch/S1MB-leaderboard
S1MB_SPACE_IMAGE=ghcr.io/hotchpotch/s1mb-leaderboard
# GitHub Actions secret for deployment; not passed into the viewer.
S1MB_SPACE_DEPLOY_TOKEN=

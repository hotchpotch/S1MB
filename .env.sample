# Evaluator credentials (never included in the viewer image).
TYPESAFE_API_KEY=
HF_TOKEN=

# Viewer filesystem configuration. CLI options override these values.
# Defaults to viewer/data/hub-results if present, otherwise viewer/data/results.
# Managed Spaces default to /mnt/results, attached as a read-only Dataset volume.
S1MB_RESULTS_DIR=
# Seconds between request-driven background checks: local 0, Space 3600.
S1MB_RESULTS_CHECK_SECONDS=
# Directory containing tracked benchmark/category definitions; defaults to viewer/data.
S1MB_DATA_DIR=

# GitHub Actions repository variables: private Docker Space and public code-only image.
S1MB_SPACE_REPO=hotchpotch/S1MB-leaderboard
S1MB_SPACE_IMAGE=ghcr.io/hotchpotch/s1mb-leaderboard
# GitHub Actions secret for deployment; not passed into the viewer.
S1MB_SPACE_DEPLOY_TOKEN=
